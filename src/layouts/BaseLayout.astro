---
import Icon from '../components/Icon.astro';
import '../styles/global.css';
import displayFont from '../assets/fonts/dm-sans.woff2?url';
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'Un parcours concret pour mieux concevoir, coder et décider avec l’IA.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const relativePath = Astro.url.pathname.slice(base.length).replace(/\/$/, '');
const isCourse =
  relativePath.startsWith('courses/') || relativePath.startsWith('lessons/');
---

<!doctype html>
<html lang="fr" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link
      rel="preload"
      href={displayFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title} | AOT Academy</title>
    <script is:inline>
      try {
        const theme = localStorage.getItem('aot-theme');
        document.documentElement.dataset.theme =
          theme === 'light' ? 'light' : 'dark';
      } catch {
        /* The default theme also works without storage. */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <header class="site-header">
      <div class="container-shell header-inner">
        <a class="brand" href={base} aria-label="AOT Academy — Accueil">
          <img
            src={`${base}brand/logo-mark.svg`}
            width="34"
            height="34"
            alt=""
          />
          <span>AOT<span class="brand-secondary">Academy</span></span>
        </a>
        <nav class="navigation" aria-label="Navigation principale">
          <a href={base} aria-current={relativePath === '' ? 'page' : undefined}
            >Accueil</a
          >
          <a
            href={`${base}courses/ia-appliquee-metiers-tech`}
            aria-current={isCourse ? 'page' : undefined}>Le parcours</a
          >
          <a
            class="mobile-quiz-link"
            href={`${base}quiz-niveau`}
            aria-current={relativePath === 'quiz-niveau' ? 'page' : undefined}
            >Me positionner</a
          >
        </nav>
        <div class="header-actions">
          <button
            id="theme-toggle"
            class="icon-button"
            type="button"
            aria-label="Basculer le thème : activer le mode clair"
            title="Activer le mode clair"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
              ><circle cx="12" cy="12" r="4"></circle><path
                d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"
              ></path></svg
            >
          </button>
          <a
            class="btn-primary header-quiz"
            href={`${base}quiz-niveau`}
            aria-current={relativePath === 'quiz-niveau' ? 'page' : undefined}
            >Me positionner <span aria-hidden="true"
              ><Icon name="arrow-up" /></span
            ></a
          >
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="container-shell footer-inner">
        <span>AOT Academy · Think. Act. Code.</span>
        <span
          >© {new Date().getFullYear()} · Accompagnement IA pour équipes tech</span
        >
        <a class="text-link" href={`${base}courses/ia-appliquee-metiers-tech`}
          >Explorer le parcours <span aria-hidden="true"
            ><Icon name="arrow-up" /></span
          ></a
        >
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const root = document.documentElement;
      function updateThemeLabel() {
        const label = `Activer le mode ${root.dataset.theme === 'dark' ? 'clair' : 'sombre'}`;
        toggle?.setAttribute(
          'aria-label',
          `Basculer le thème : ${label.toLowerCase()}`,
        );
        if (toggle) toggle.title = label;
      }
      toggle?.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        try {
          localStorage.setItem('aot-theme', root.dataset.theme);
        } catch {
          /* Keep the current choice for this page. */
        }
        updateThemeLabel();
      });
      updateThemeLabel();
    </script>
  </body>
</html>
