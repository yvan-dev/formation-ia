---
import Icon from '../components/Icon.astro';
import BaseLayout from './BaseLayout.astro';
import LessonSidebar from '../components/LessonSidebar.astro';
import ProgressBar from '../components/ProgressBar.astro';
import { getEntry, type CollectionEntry } from 'astro:content';

interface LessonFrontmatter {
  title: string;
  courseSlug: string;
  lessonSlug: string;
  courseTitle?: string;
  modules?: CollectionEntry<'courses'>['data']['modules'];
  duration?: string;
}
interface Props extends LessonFrontmatter {
  frontmatter?: LessonFrontmatter;
}
const props = Astro.props.frontmatter || Astro.props;
const { title, courseSlug, lessonSlug, duration } = props;
const courseEntry = await getEntry('courses', courseSlug);
const courseTitle = courseEntry?.data.title ?? props.courseTitle ?? 'Formation';
const modules = courseEntry?.data.modules ?? props.modules ?? [];
const visibleModules = import.meta.env.DEV
  ? modules
  : modules.filter((module, index) => module.released ?? index < 3);
const base = import.meta.env.BASE_URL;
const allLessons = visibleModules.flatMap((m) => m.lessons);
const currentIndex = allLessons.findIndex((l) => l.slug === lessonSlug);
const prevLesson = currentIndex > 0 ? allLessons[currentIndex - 1] : null;
const nextLesson =
  currentIndex >= 0 && currentIndex < allLessons.length - 1
    ? allLessons[currentIndex + 1]
    : null;
---

<BaseLayout title={title}>
  <div class="container-shell lesson-breadcrumb">
    <nav class="breadcrumb" aria-label="Fil d’Ariane">
      <a href={base}>Accueil</a><span aria-hidden="true">/</span><a
        href={`${base}courses/${courseSlug}`}>{courseTitle}</a
      >
    </nav><span class="mono muted"
      >{
        currentIndex >= 0
          ? `Leçon ${currentIndex + 1} / ${allLessons.length}`
          : 'Leçon en préparation'
      }</span
    >
  </div>
  <div class="container-shell lesson-layout">
    <aside class="desktop-lesson-nav">
      <LessonSidebar
        courseSlug={courseSlug}
        courseTitle={courseTitle}
        modules={visibleModules}
        currentLesson={lessonSlug}
      />
    </aside>
    <div class="lesson-main">
      <details class="mobile-lesson-nav">
        <summary>Le programme et les autres leçons</summary><LessonSidebar
          courseSlug={courseSlug}
          courseTitle={courseTitle}
          modules={visibleModules}
          currentLesson={lessonSlug}
        />
      </details>
      <ProgressBar
        courseSlug={courseSlug}
        lessonSlugs={allLessons.map((lesson) => lesson.slug)}
      />
      <header class="lesson-heading">
        <p class="eyebrow">
          {currentIndex >= 0 ? `Leçon ${currentIndex + 1}` : 'En préparation'}{
            duration ? ` / ${duration}` : ''
          }
        </p><h1>{title}</h1>
      </header>
      <article class="prose-shell" data-pagefind-body><slot /></article>
      <div class="lesson-completion">
        <div>
          <strong>Une étape de plus.</strong><p
            id="completion-status"
            role="status"
          >
            Validez cette leçon pour suivre votre progression.
          </p>
        </div><button
          id="mark-complete-btn"
          class="btn-primary"
          type="button"
          data-course={courseSlug}
          data-lesson={lessonSlug}
          ><span data-complete-label>Marquer la leçon comme terminée</span>
          <span aria-hidden="true"><Icon name="check" /></span></button
        >
      </div>
      <nav class="lesson-pagination" aria-label="Leçons précédente et suivante">
        {
          prevLesson ? (
            <a href={`${base}lessons/${courseSlug}/${prevLesson.slug}`}>
              <>
                <span class="eyebrow">
                  <Icon name="arrow-left" /> Précédente
                </span>
                <strong>{prevLesson.title}</strong>
              </>
            </a>
          ) : (
            <span />
          )
        }
        {
          nextLesson ? (
            <a href={`${base}lessons/${courseSlug}/${nextLesson.slug}`}>
              <>
                <span class="eyebrow">
                  Suivante <Icon name="arrow-right" />
                </span>
                <strong>{nextLesson.title}</strong>
              </>
            </a>
          ) : (
            <a href={`${base}courses/${courseSlug}`}>
              <>
                <span class="eyebrow">
                  Retour au programme <Icon name="arrow-right" />
                </span>
                <strong>{courseTitle}</strong>
              </>
            </a>
          )
        }
      </nav>
    </div>
    <aside class="lesson-toc">
      <nav aria-label="Dans cette leçon">
        <p class="mono muted">Dans cette leçon</p><div id="lesson-toc-links">
        </div>
      </nav>
    </aside>
  </div>
  <script>
    import {
      completeLesson,
      readProgress,
      refreshProgress,
    } from '../lib/progress';
    const button =
      document.querySelector<HTMLButtonElement>('#mark-complete-btn');
    const status = document.querySelector('#completion-status');
    function updateCompletion() {
      if (!button) return;
      const done = readProgress(button.dataset.course ?? '').includes(
        button.dataset.lesson ?? '',
      );
      button.disabled = done;
      button.dataset.completed = String(done);
      if (done) {
        const label = button.querySelector('[data-complete-label]');
        if (label) label.textContent = 'Leçon terminée';
        if (status)
          status.textContent =
            'Votre progression est enregistrée sur cet appareil.';
      }
      refreshProgress();
    }
    button?.addEventListener('click', () => {
      const saved = completeLesson(
        button.dataset.course ?? '',
        button.dataset.lesson ?? '',
      );
      if (saved) updateCompletion();
      else if (status)
        status.textContent =
          'La progression n’a pas pu être enregistrée. Autorisez le stockage du navigateur, puis réessayez.';
    });
    updateCompletion();
    const toc = document.querySelector('#lesson-toc-links');
    document
      .querySelectorAll<HTMLElement>('[data-pagefind-body] h2[id]')
      .forEach((heading) => {
        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent;
        toc?.append(link);
      });
  </script>
</BaseLayout>
