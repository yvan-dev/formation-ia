---
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroArtwork from '../components/HeroArtwork.astro';
import CourseCard from '../components/CourseCard.astro';
import MaturityStepper from '../components/MaturityStepper.astro';
import developpement from '../assets/illustrations/developpement.webp';
import architecture from '../assets/illustrations/architecture.webp';
import devops from '../assets/illustrations/devops-qa.webp';
import produit from '../assets/illustrations/produit.webp';
const courses = await getCollection('courses');
const base = import.meta.env.BASE_URL;
const primaryCourse =
  courses.find((course) => course.id === 'ia-appliquee-metiers-tech') ??
  courses[0];
if (!primaryCourse) throw new Error('Aucune formation disponible');
const teams = [
  {
    image: developpement,
    caption: 'Développement',
    alt: 'Ordinateur portable et symboles de code.',
  },
  {
    image: architecture,
    caption: 'Architecture',
    alt: 'Composants logiciels organisés en réseau.',
  },
  {
    image: devops,
    caption: 'DevOps & QA',
    alt: 'Serveurs reliés à un bouclier de validation.',
  },
  {
    image: produit,
    caption: 'Produit',
    alt: 'Une équipe travaille sur des interfaces et un parcours utilisateur.',
  },
];
---

<BaseLayout title="Accueil">
  <section class="container-shell hero">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="small-line" aria-hidden="true"></span>L’IA appliquée aux
        métiers tech
      </p>
      <h1>
        L’IA devient <br />une compétence. <br /><span class="accent"
          >Faites-en la vôtre.</span
        >
      </h1>
      <p class="hero-description">
        Du premier prompt au workflow maîtrisé. <br />Un parcours concret pour
        mieux concevoir, coder et décider avec l’IA.
      </p>
      <div class="hero-actions">
        <a class="btn-primary" href={`${base}quiz-niveau`}
          >Trouver mon point de départ <span aria-hidden="true"
            ><Icon name="arrow-up" /></span
          ></a
        >
        <a class="text-link" href={`${base}courses/${primaryCourse.id}`}
          >Explorer le parcours <span aria-hidden="true"
            ><Icon name="arrow-right" /></span
          ></a
        >
      </div>
      <p class="microcopy">
        Quiz de placement · 4 minutes · Sans prérequis en IA
      </p>
    </div>
    <HeroArtwork />
  </section>
  <section
    class="container-shell team-gallery"
    aria-label="Les équipes qui construisent avec l’IA"
  >
    {
      teams.map((team) => (
        <figure>
          <>
            <div class="team-visual">
              <Image
                src={team.image}
                alt={team.alt}
                widths={[240, 480, 720]}
                sizes="(max-width: 600px) 44vw, 22vw"
                width={720}
                height={720}
              />
            </div>
            <figcaption>{team.caption}</figcaption>
          </>
        </figure>
      ))
    }
  </section>
  <section
    id="formations"
    class="container-shell course-section"
    aria-labelledby="course-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / Le parcours</p><h2 id="course-title">
          Apprendre pour faire.
        </h2>
      </div><p>
        Des fondamentaux solides.<br />Des pratiques à appliquer sur vos
        projets.
      </p>
    </div>
    <CourseCard slug={primaryCourse.id} {...primaryCourse.data} />
  </section>
  <section class="container-shell maturity-section">
    <MaturityStepper
      basePath={base}
      courseSlug={primaryCourse.id}
      variant="home"
    />
  </section>
</BaseLayout>
