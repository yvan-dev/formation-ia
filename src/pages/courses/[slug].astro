---
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  return courses.map((course) => ({
    params: { slug: course.id },
    props: { course },
  }));
}

const { course } = Astro.props;
const {
  title,
  description,
  modules,
  publicCible,
  prerequis,
  format,
  livrableFinal,
  objectifsGlobaux,
} = course.data;

const base = import.meta.env.BASE_URL;

interface Lesson {
  slug: string;
  title: string;
}

interface Module {
  title: string;
  public?: 'tous' | 'profils techniques';
  objectifs?: string[];
  livrable?: string;
  exercices?: string[];
  released?: boolean;
  lessons: Lesson[];
}

const availableModules = modules.filter((module: Module, index: number) =>
  typeof module.released === 'boolean' ? module.released : index < 3,
);
const comingSoonModules = modules.filter((module: Module, index: number) =>
  typeof module.released === 'boolean' ? !module.released : index >= 3,
);

const totalLessons = availableModules.reduce(
  (a: number, m: Module) => a + m.lessons.length,
  0,
);

const availableLessonSlugs = availableModules.flatMap((module: Module) =>
  module.lessons.map((lesson: Lesson) => lesson.slug),
);

const hasMetadata = publicCible || prerequis || format || livrableFinal;
---

<BaseLayout title={title} description={description}>
  <div class="container-shell page-head">
    <nav class="breadcrumb" aria-label="Fil d’Ariane">
      <a href={base}>Accueil</a><span aria-hidden="true">/</span><span
        >Le parcours</span
      >
    </nav>
    <p class="eyebrow">
      Formation{course.data.level ? ` / ${course.data.level}` : ''}
    </p>
    <h1>{title}</h1>
    <p class="hero-description">{description}</p>
  </div>
  <div class="container-shell course-layout">
    <div>
      <div class="section-heading compact">
        <h2>Le programme</h2><span class="muted"
          >{availableModules.length} modules · {totalLessons} leçons disponibles</span
        >
      </div>
      <div
        class="course-progress"
        data-course-progress={course.id}
        data-lessons={JSON.stringify(availableLessonSlugs)}
      >
        <div class="progress-label">
          <span>Votre progression</span><span
            id="progress-text"
            data-progress-text>0 / {totalLessons} leçons</span
          >
        </div>
        <progress
          id="course-progress-fill"
          value="0"
          max={Math.max(1, totalLessons)}
          aria-label="Progression de la formation"></progress>
      </div>
      <div data-lesson-nav={course.id}>
        {
          availableModules.map((module: Module, moduleIndex: number) => (
            <details
              class="module-details"
              id={`module-${moduleIndex + 1}`}
              open={moduleIndex === 0}
            >
              <summary>
                <>
                  <span class="mono">
                    {String(moduleIndex + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <>
                      <h3>{module.title}</h3>
                      <p>
                        {module.lessons.length} leçons
                        {module.public
                          ? ` · ${module.public === 'tous' ? 'Tous profils' : 'Profils techniques'}`
                          : ''}
                      </p>
                    </>
                  </div>
                </>
              </summary>
              <div class="module-content">
                {module.objectifs && (
                  <ul class="module-objectives">
                    {module.objectifs.map((obj) => (
                      <li>{obj}</li>
                    ))}
                  </ul>
                )}
                {module.livrable && (
                  <p class="module-deliverable">
                    <strong>Livrable :</strong> {module.livrable}
                  </p>
                )}
                <ul class="module-lessons">
                  {module.lessons.map((lesson: Lesson, index: number) => (
                    <li>
                      <a
                        class="curriculum-lesson"
                        href={`${base}lessons/${course.id}/${lesson.slug}`}
                        data-lesson-item={lesson.slug}
                        data-lesson-slug={lesson.slug}
                      >
                        <span class="mono lesson-number">
                          {String(index + 1).padStart(2, '0')}
                        </span>
                        <span>{lesson.title}</span>
                        <span
                          class="lesson-check"
                          data-completion-status
                          hidden
                        >
                          <span aria-hidden="true">
                            <Icon name="check" />
                          </span>
                          <span class="sr-only">Leçon terminée</span>
                        </span>
                        <span class="lesson-arrow" aria-hidden="true">
                          <Icon name="arrow-up" />
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
                {module.exercices && module.exercices.length > 0 && (
                  <details class="content-details">
                    <summary>Exercices pratiques</summary>
                    <ul>
                      {module.exercices.map((exercice) => (
                        <li>{exercice}</li>
                      ))}
                    </ul>
                  </details>
                )}
              </div>
            </details>
          ))
        }
      </div>
      {
        comingSoonModules.length > 0 && (
          <section class="coming-soon">
            <>
              <h2>La suite du parcours</h2>
              <p>
                Ces modules seront activés progressivement après stabilisation
                du socle opérationnel.
              </p>
              <ul>
                {comingSoonModules.map((module: Module) => (
                  <li>
                    <h3>{module.title}</h3>
                    <span class="muted">Bientôt disponible</span>
                  </li>
                ))}
              </ul>
            </>
          </section>
        )
      }
      {
        objectifsGlobaux && objectifsGlobaux.length > 0 && (
          <details class="content-details course-objectives">
            <>
              <summary>Objectifs du parcours</summary>
              <ul>
                {objectifsGlobaux.map((obj) => (
                  <li>{obj}</li>
                ))}
              </ul>
            </>
          </details>
        )
      }
    </div>
    <aside class="course-aside">
      <p class="eyebrow">Votre point de départ</p><h2>
        Le bon parcours commence avec vous.
      </h2><p>
        Identifiez votre niveau actuel et la prochaine étape utile en quelques
        minutes.
      </p>
      <a class="btn-primary" href={`${base}quiz-niveau`}
        >Faire le quiz <span aria-hidden="true"><Icon name="arrow-up" /></span
        ></a
      >
      {
        hasMetadata && (
          <>
            <>
              <hr />
              <dl>
                {publicCible && (
                  <div>
                    <dt>Pour qui ?</dt>
                    <dd>{publicCible}</dd>
                  </div>
                )}
                {prerequis && (
                  <div>
                    <dt>Prérequis</dt>
                    <dd>{prerequis}</dd>
                  </div>
                )}
                {format && (
                  <div>
                    <dt>Format</dt>
                    <dd>{format}</dd>
                  </div>
                )}
                {livrableFinal && (
                  <div>
                    <dt>À la clé</dt>
                    <dd>{livrableFinal}</dd>
                  </div>
                )}
              </dl>
            </>
          </>
        )
      }
    </aside>
  </div>
  <script>
    import { refreshProgress } from '../../lib/progress';
    refreshProgress();
    window.addEventListener('storage', refreshProgress);
    // A module link from the homepage opens its matching native disclosure.
    function openLinkedModule() {
      const target = document.getElementById(window.location.hash.slice(1));
      if (target instanceof HTMLDetailsElement) target.open = true;
    }
    openLinkedModule();
    window.addEventListener('hashchange', openLinkedModule);
  </script>
</BaseLayout>
