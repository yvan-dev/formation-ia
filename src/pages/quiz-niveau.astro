---
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import hero from '../assets/illustrations/hero.webp';
import BaseLayout from '../layouts/BaseLayout.astro';
import LevelQuiz from '../components/LevelQuiz';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Quiz de placement">
  <div class="container-shell quiz-layout">
    <div class="quiz-intro">
      <div class="quiz-emblem">
        <Image src={hero} width={180} height={180} alt="" loading="lazy" />
      </div>
      <p class="eyebrow">Quiz de placement / 4 minutes</p><h1>
        Votre prochaine étape <span class="accent">commence ici.</span>
      </h1><p>
        Dix questions pour situer vos pratiques, identifier votre niveau et
        choisir les bons leviers de progression.
      </p><div class="quiz-facts">
        <span><Icon name="chat" /> 10 questions</span><span
          ><Icon name="route" /> 5 niveaux</span
        ><span><Icon name="target" /> Un plan à 30 jours</span>
      </div>
      <p class="quiz-privacy">
        Votre résultat est enregistré sur cet appareil.
      </p><a class="text-link" href={`${base}courses/ia-appliquee-metiers-tech`}
        >Explorer le parcours <span aria-hidden="true"
          ><Icon name="arrow-up" /></span
        ></a
      >
    </div>
    <LevelQuiz client:load basePath={base} />
  </div>
</BaseLayout>
