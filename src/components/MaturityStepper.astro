---
import Icon from './Icon.astro';
interface Props {
  basePath: string;
  courseSlug: string;
  variant?: 'default' | 'home';
}
const { basePath, courseSlug, variant = 'default' } = Astro.props;
const levels = [
  { title: 'Chat', description: 'Poser les bonnes questions.' },
  { title: 'Copilote', description: 'Travailler avec du contexte.' },
  { title: 'Agent guidé', description: 'Déléguer avec supervision.' },
  { title: 'Human in the Loop', description: 'Automatiser avec contrôle.' },
  { title: 'Swarm', description: 'Orchestrer plusieurs agents.' },
];
---

<div class="section-heading">
  <div>
    <p class="eyebrow">02 / La progression</p><h2>
      Un cap. Une étape à la fois.
    </h2>
  </div><a
    class="text-link"
    href={variant === 'home'
      ? `${basePath}quiz-niveau`
      : `${basePath}lessons/${courseSlug}/niveaux-maturite`}
    >{variant === 'home' ? 'Situer mon niveau' : 'Voir le détail'}
    <span aria-hidden="true"><Icon name="arrow-up" /></span></a
  >
</div>
<ol class="maturity-grid" aria-label="Les cinq niveaux de maturité IA">
  {
    levels.map((level, index) => (
      <li class:list={[index === 2 && 'maturity-target']}>
        <>
          <span class="mono">
            {String(index + 1).padStart(2, '0')}
            {index === 2 && <span class="target-label">Notre cap</span>}
          </span>
          <h3>{level.title}</h3>
          <p>{level.description}</p>
        </>
      </li>
    ))
  }
</ol>
