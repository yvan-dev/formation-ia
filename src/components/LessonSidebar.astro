---
import Icon from './Icon.astro';
interface Props {
  courseSlug: string;
  courseTitle: string;
  modules: Array<{
    title: string;
    lessons: Array<{ slug: string; title: string }>;
  }>;
  currentLesson: string;
}
const { courseSlug, modules, currentLesson } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<nav
  class="lesson-sidebar"
  aria-label="Programme de la formation"
  data-lesson-nav={courseSlug}
>
  <a class="text-link" href={`${base}courses/${courseSlug}`}
    ><span aria-hidden="true"><Icon name="arrow-left" /></span> Le programme</a
  >
  {
    modules.map((module, moduleIndex) => (
      <div class="sidebar-module">
        <>
          <p class="eyebrow">
            Module {String(moduleIndex + 1).padStart(2, '0')}
          </p>
          <h2>{module.title}</h2>
          <ul>
            {module.lessons.map((lesson, index) => (
              <li>
                <a
                  class="sidebar-lesson"
                  href={`${base}lessons/${courseSlug}/${lesson.slug}`}
                  data-lesson-slug={lesson.slug}
                  aria-current={
                    lesson.slug === currentLesson ? 'page' : undefined
                  }
                >
                  <span class="mono">{String(index + 1).padStart(2, '0')}</span>
                  <span>{lesson.title}</span>
                  <span class="lesson-check" data-completion-status hidden>
                    <span aria-hidden="true">
                      <Icon name="check" />
                    </span>
                    <span class="sr-only">Leçon terminée</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </>
      </div>
    ))
  }
</nav>
