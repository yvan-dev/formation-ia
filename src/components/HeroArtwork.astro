---
import { Image } from 'astro:assets';
import hero from '../assets/illustrations/hero.webp';
---

<figure class="hero-art" data-animation="paused">
  <svg
    class="neural-backdrop"
    viewBox="0 0 1000 1000"
    fill="none"
    aria-hidden="true"
    focusable="false"
    ><circle cx="500" cy="490" r="360" fill="var(--accent-soft)"></circle><g
      stroke="currentColor"
      stroke-width="1"
      ><circle cx="500" cy="490" r="420"></circle><path
        d="M65 490h65m740 0h65M500 55v65m0 740v65M165 185l35 35m600 600 35 35M165 835l35-35m600-580 35-35"
      ></path></g
    ></svg
  >
  <Image
    class="neural-emblem"
    src={hero}
    widths={[320, 640, 960, 1200]}
    sizes="(max-width: 850px) 90vw, 45vw"
    width={1200}
    height={1200}
    loading="eager"
    fetchpriority="high"
    alt="Un noyau d’intelligence artificielle : réseau neuronal lumineux violet, cœur cristallin et orbites en titane."
  />
  <svg
    class="future-layer"
    viewBox="0 0 1000 1000"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <g transform="rotate(-28 500 490)"
      ><g class="orbital-rotation orbit-one"
        ><ellipse
          cx="500"
          cy="490"
          rx="425"
          ry="210"
          stroke="currentColor"
          stroke-width="1.7"></ellipse><path
          d="M75 490a425 210 0 0 1 425-210"
          stroke="currentColor"
          stroke-width="3.5"></path><circle
          class="energy-dot"
          cx="925"
          cy="490"
          r="7"
          fill="currentColor"></circle><circle
          cx="500"
          cy="280"
          r="4"
          fill="currentColor"></circle></g
      ></g
    >
    <g transform="rotate(55 500 490)"
      ><g class="orbital-rotation orbit-two"
        ><ellipse
          cx="500"
          cy="490"
          rx="385"
          ry="200"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-dasharray="8 18"></ellipse><circle
          class="energy-dot dot-two"
          cx="115"
          cy="490"
          r="6"
          fill="currentColor"></circle><path
          d="M500 690a385 200 0 0 1-385-200"
          stroke="currentColor"
          stroke-width="2.5"></path></g
      ></g
    >
    <g class="signal-packet packet-one"
      ><rect
        x="135"
        y="240"
        width="58"
        height="38"
        rx="7"
        fill="var(--surface)"
        stroke="currentColor"></rect><path
        d="M146 252h35m-35 10h22"
        stroke="currentColor"
        stroke-width="2"></path></g
    >
    <g class="signal-packet packet-two"
      ><rect
        x="785"
        y="674"
        width="62"
        height="44"
        rx="8"
        fill="var(--surface)"
        stroke="currentColor"></rect><path
        d="m798 697 10 9 23-24"
        stroke="currentColor"
        stroke-width="2"></path></g
    >
    <g class="core-pulse" stroke="currentColor" stroke-width="1.8"
      ><circle cx="500" cy="490" r="75"></circle><path
        d="M500 400v15m0 150v15M410 490h15m150 0h15"></path></g
    >
    <g class="data-wave" stroke="currentColor" stroke-width="1.5"
      ><path d="m172 746 90-72 110 34 116-107 148 89 125-117 80 41"
      ></path><circle cx="372" cy="708" r="5" fill="currentColor"
      ></circle><circle cx="636" cy="690" r="5" fill="currentColor"></circle></g
    >
  </svg>
  <button
    class="hero-motion-toggle"
    type="button"
    aria-label="Mettre l’animation en pause"
    aria-pressed="false"
    title="Mettre l’animation en pause"
    hidden
  >
    <svg
      class="pause-glyph"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"><path d="M9 6v12M15 6v12"></path></svg
    >
    <svg
      class="play-glyph"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"><path d="M9 5l10 7-10 7z"></path></svg
    >
  </button>
</figure>
<script>
  const heroArtwork = document.querySelector<HTMLElement>('.hero-art');
  const toggle = heroArtwork?.querySelector<HTMLButtonElement>(
    '.hero-motion-toggle',
  );
  if (heroArtwork && toggle) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let userPaused = false;
    let inViewport = false;

    const syncHeroMotion = () => {
      const reduced = reducedMotion.matches;
      const running = !reduced && !userPaused && inViewport && !document.hidden;
      heroArtwork.dataset.animation = reduced
        ? 'reduced'
        : running
          ? 'running'
          : 'paused';
      toggle.hidden = reduced;
      toggle.setAttribute('aria-pressed', String(userPaused));
      const label = userPaused
        ? 'Reprendre l’animation'
        : 'Mettre l’animation en pause';
      toggle.setAttribute('aria-label', label);
      toggle.title = label;
    };

    toggle.addEventListener('click', () => {
      userPaused = !userPaused;
      syncHeroMotion();
    });
    const observer = new IntersectionObserver(
      ([entry]) => {
        inViewport = entry.isIntersecting;
        syncHeroMotion();
      },
      { threshold: 0.15 },
    );
    observer.observe(heroArtwork);
    reducedMotion.addEventListener('change', syncHeroMotion);
    document.addEventListener('visibilitychange', syncHeroMotion);
    syncHeroMotion();
  }
</script>
<style>
  .hero-art {
    position: relative;
    isolation: isolate;
    background: transparent;
    overflow: visible;
  }
  .neural-backdrop,
  .future-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--accent);
    pointer-events: none;
  }
  .neural-backdrop {
    z-index: -1;
  }
  .neural-backdrop g {
    opacity: 0.24;
  }
  .neural-emblem {
    position: relative;
    padding: 12px;
  }
  .future-layer {
    opacity: 0.84;
  }
  .orbital-rotation {
    transform-box: view-box;
    transform-origin: 500px 490px;
    animation: orbital-spin 14s linear infinite;
  }
  .orbit-two {
    animation-duration: 20s;
    animation-direction: reverse;
    opacity: 0.75;
  }
  .energy-dot {
    animation: signal-beacon 3.6s ease-out infinite;
  }
  .dot-two {
    animation-delay: 1.8s;
  }
  .signal-packet {
    transform-box: fill-box;
    transform-origin: center;
    animation: packet-float 5s ease-out infinite;
  }
  .packet-two {
    animation-delay: 2.5s;
  }
  .core-pulse {
    transform-box: view-box;
    transform-origin: 500px 490px;
    animation: core-signal 4s ease-out infinite;
  }
  .data-wave {
    animation: data-signal 6s ease-out infinite;
  }
  .hero-art .future-layer * {
    animation-play-state: paused;
  }
  .hero-art[data-animation='running'] .future-layer * {
    animation-play-state: running;
  }
  .hero-art[data-animation='reduced'] .future-layer {
    display: none;
  }
  .hero-motion-toggle {
    position: absolute;
    top: 8px;
    right: 8px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    padding: 0;
  }
  .hero-motion-toggle svg {
    width: 20px;
    height: 20px;
  }
  .hero-motion-toggle .play-glyph {
    display: none;
  }
  .hero-motion-toggle[aria-pressed='true'] .pause-glyph {
    display: none;
  }
  .hero-motion-toggle[aria-pressed='true'] .play-glyph {
    display: block;
  }
  .hero-motion-toggle:hover {
    background: var(--surface-strong);
  }
  @keyframes orbital-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes signal-beacon {
    0%,
    100% {
      opacity: 0.6;
    }
    50% {
      opacity: 1;
    }
  }
  @keyframes packet-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-15px);
    }
  }
  @keyframes core-signal {
    0% {
      transform: scale(0.8);
      opacity: 0;
    }
    30% {
      opacity: 0.7;
    }
    100% {
      transform: scale(1.65);
      opacity: 0;
    }
  }
  @keyframes data-signal {
    0%,
    100% {
      opacity: 0;
      transform: translateY(12px);
    }
    45%,
    65% {
      opacity: 0.7;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-art .future-layer,
    .hero-motion-toggle {
      display: none !important;
    }
    .hero-art .future-layer * {
      animation: none !important;
    }
  }
</style>
