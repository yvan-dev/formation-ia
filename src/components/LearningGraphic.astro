  class="learning-graphic"
  viewBox="0 0 260 140"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <g stroke="currentColor" stroke-width="1.5">
    {
      kind === 'foundations' && (
        <>
          <>
