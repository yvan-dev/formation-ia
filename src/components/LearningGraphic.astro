              class="graphic-faint"
              d="M30 105h200M60 105V75h40v30m-20-30V47h100v58m-20-58V20h40v85"
            />
            <path d="m53 62 30-20 46 19 53-34 35 13" />
            <circle cx="83" cy="42" r="5" class="graphic-node" />
            <circle cx="129" cy="61" r="5" class="graphic-node" />
            <circle cx="182" cy="27" r="5" class="graphic-node" />
            <path class="graphic-faint" d="M38 113h170M53 121h160" />
          </>
        </>
      )
    }
    {
      kind === 'models' && (
        <>
          <>
            <path
              class="graphic-faint"
              d="M68 28h124v84H68zM46 44H28v52h18m168-52h18v52h-18"
            />
            <circle cx="130" cy="70" r="30" />
            <path d="m105 51 50 38m-50 0 50-38M130 40v60M100 70h60" />
            <circle cx="130" cy="70" r="7" class="graphic-node" />
            <circle cx="105" cy="51" r="4" class="graphic-node" />
            <circle cx="155" cy="89" r="4" class="graphic-node" />
