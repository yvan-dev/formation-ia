      )
    }
    {
      kind === 'workflow' && (
        <>
          <>
            <path
              class="graphic-faint"
              d="M55 73h148M87 73v-40h54v40m-54 0v34h54V73"
            />
            <rect x="25" y="53" width="48" height="40" rx="9" />
            <rect x="93" y="12" width="48" height="40" rx="9" />
            <rect x="93" y="88" width="48" height="40" rx="9" />
            <rect x="177" y="53" width="48" height="40" rx="9" />
