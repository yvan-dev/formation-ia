---
interface Props {
  courseSlug: string;
  lessonSlugs: string[];
}
const { courseSlug, lessonSlugs } = Astro.props;
---

<div
  class="lesson-progress"
  data-course-progress={courseSlug}
  data-lessons={JSON.stringify(lessonSlugs)}
>
  <div class="progress-label">
    <span>Votre progression</span><span data-progress-text
      >0 / {lessonSlugs.length} leçons</span
    >
  </div>
  <progress
    value="0"
    max={Math.max(1, lessonSlugs.length)}
    aria-label="Progression de la formation"></progress>
</div>
<script>
  import { refreshProgress } from '../lib/progress';
  refreshProgress();
  window.addEventListener('lesson-completed', refreshProgress);
  window.addEventListener('storage', refreshProgress);
</script>
