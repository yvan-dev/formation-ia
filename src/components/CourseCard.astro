---
import Icon from './Icon.astro';
interface Props {
  slug: string;
  title: string;
  description: string;
  level?: string;
  modules: Array<{
    title: string;
    released?: boolean;
    lessons: Array<{ slug: string; title: string }>;
  }>;
}
const { slug, title, description, level, modules } = Astro.props;
const base = import.meta.env.BASE_URL;
const available = modules.filter(
  (module, index) => module.released ?? index < 3,
);
const lessonCount = available.reduce(
  (count, module) => count + module.lessons.length,
  0,
);
---

<article class="course-feature">
  <div class="course-intro">
    <span class="badge">Disponible maintenant{level ? ` · ${level}` : ''}</span>
    <h3>{title}</h3>
    <p>{description}</p>
    <div class="course-stats">
      <div>
        <strong>{String(available.length).padStart(2, '0')}</strong><span
          >modules disponibles</span
        >
      </div><div>
        <strong>{lessonCount}</strong><span>leçons accessibles</span>
      </div>
    </div>
    <a class="text-link accent" href={`${base}courses/${slug}`}
      >Découvrir la formation <span aria-hidden="true"
        ><Icon name="arrow-up" /></span
      ></a
    >
  </div>
  <div class="course-outline">
    <p class="mono outline-label">Votre feuille de route</p>
    {
      available.map((module, index) => (
        <a
          class="module-row"
          href={`${base}courses/${slug}#module-${index + 1}`}
        >
          <>
            <span class="mono">{String(index + 1).padStart(2, '0')}</span>
            <h4>{module.title}</h4>
            <span class="module-meta">
              {module.lessons.length} leçons{' '}
              <span aria-hidden="true">
                <Icon name="arrow-up" />
              </span>
            </span>
          </>
        </a>
      ))
    }
    {
      modules.length > available.length && (
        <p class="roadmap-note">
          {modules.length - available.length} modules supplémentaires en
          préparation.
        </p>
      )
    }
  </div>
</article>
