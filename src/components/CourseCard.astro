---
import Icon from './Icon.astro';
import LearningGraphic from './LearningGraphic.astro';
interface Props {
  slug: string;
  title: string;
  description: string;
  level?: string;
  modules: Array<{
    title: string;
    released?: boolean;
    lessons: Array<{ slug: string; title: string }>;
  }>;
}
const { slug, title, description, level, modules } = Astro.props;
const base = import.meta.env.BASE_URL;
const available = modules.filter(
  (module, index) => module.released ?? index < 3,
);
const lessonCount = available.reduce(
  (count, module) => count + module.lessons.length,
  0,
);
const stages = [
  { icon: 'compass', title: 'Poser les fondations', kind: 'foundations' },
  { icon: 'brain', title: 'Comprendre & mieux prompter', kind: 'models' },
  { icon: 'code', title: 'Construire son workflow', kind: 'workflow' },
] as const;
---

<article class="course-experience">
  <div class="course-summary">
    <div>
      <span class="badge"
        ><Icon name="spark" /> Disponible maintenant{
          level ? ` · ${level}` : ''
        }</span
      ><h3>{title}</h3><p>{description}</p>
    </div>
    <div class="course-entry">
      <div class="course-stats">
        <div>
          <strong>{String(available.length).padStart(2, '0')}</strong><span
            >modules disponibles</span
          >
        </div><div>
          <strong>{lessonCount}</strong><span>leçons accessibles</span>
        </div>
      </div><a class="btn-primary" href={`${base}courses/${slug}`}
        >Découvrir la formation <Icon name="arrow-up" /></a
      >
    </div>
  </div>
  <ol class="learning-path" aria-label="Les étapes du parcours">
    {
      available.map((module, index) => {
        const stage = stages[index] ?? stages[2];
        return (
          <li>
            <a
              class="module-row"
              href={`${base}courses/${slug}#module-${index + 1}`}
            >
              <>
                <div class="path-card-top">
                  <>
                    <span class="mono">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span class="path-icon">
                      <Icon name={stage.icon} />
                    </span>
                  </>
                </div>
                <LearningGraphic kind={stage.kind} />
                <h4>{stage.title}</h4>
                <p>{module.title}</p>
                <div class="path-card-bottom">
                  <>
                    <span>{module.lessons.length} leçons</span>
                    <Icon name="arrow-up" />
                  </>
                </div>
              </>
            </a>
          </li>
        );
      })
    }
  </ol>
  {
    modules.length > available.length && (
      <p class="roadmap-note">
        <Icon name="route" /> {modules.length - available.length} modules
        supplémentaires en préparation.
      </p>
    )
  }
</article>
